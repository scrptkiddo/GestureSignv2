<UserControl x:Class="GestureSign.CorePlugins.HotKey.HotKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:hotKey="clr-namespace:GestureSign.CorePlugins.HotKey"
             mc:Ignorable="d"
             d:DesignWidth="350">
    <UserControl.Resources>
        <ObjectDataProvider  ObjectType="{x:Type hotKey:ExtraKeysDescription}"
                             x:Key="ExtraKeys">
        </ObjectDataProvider>
        <!-- English-only fork: readable modifier toggle buttons.
             Unchecked = light chip + dark text; Checked = solid blue + white text. -->
        <Style x:Key="ModifierToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Background" Value="#FFEEF2F7" />
            <Setter Property="BorderBrush" Value="#FF9AB0C6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="27" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFDCE6F2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2563EB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1E4FC0" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D4ED8" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid PreviewKeyDown="Grid_PreviewKeyDown"
          Margin="0"
          PreviewKeyUp="Grid_PreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <ComboBox x:Name="ExtraKeysComboBox"
                  ItemsSource="{Binding Source={StaticResource ExtraKeys},Path=DescriptionDict}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  VerticalAlignment="Top"
                  FontSize="14"
                  SelectionChanged="ExtraKeysComboBox_SelectionChanged" />
        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Left"
                   TextWrapping="Wrap"
                   Text="{localization:LocalisedText CorePlugins.HotKey.Tip}"
                   VerticalAlignment="Top"
                   Margin="0,45,0,0" />
        <ToggleButton Grid.Row="0"
                      x:Name="chkWin"
                      Content="Win"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Width="83"
                      Focusable="False"
                      FontSize="12"
                      Style="{StaticResource ModifierToggleButtonStyle}"
                      Margin="0,72,0,0" />
        <ToggleButton Grid.Row="0"
                      x:Name="chkControl"
                      Content="Ctrl"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Width="83"
                      Focusable="False"
                      FontSize="12"
                      Style="{StaticResource ModifierToggleButtonStyle}"
                      Margin="89,72,0,0" />
        <ToggleButton Grid.Row="0"
                      x:Name="chkShift"
                      Content="Shift"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Width="83"
                      Focusable="False"
                      FontSize="12"
                      Style="{StaticResource ModifierToggleButtonStyle}"
                      Margin="178,71,0,0" />
        <ToggleButton Grid.Row="0"
                      x:Name="chkAlt"
                      Content="Alt"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Width="83"
                      Focusable="False"
                      FontSize="12"
                      Style="{StaticResource ModifierToggleButtonStyle}"
                      Margin="267,71,0,0" />
        <TextBox x:Name="txtKey"
                 InputMethod.IsInputMethodEnabled="False"
                 HorizontalAlignment="Left"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="261"
                 FontSize="14"
                 MaxLines="5"
                 Margin="0,10,0,0"
                 Grid.Row="1">
            <TextBox.ContextMenu>
                <ContextMenu Visibility="Collapsed" />
            </TextBox.ContextMenu>
        </TextBox>
        <Button x:Name="ResetButton"
                Content="{localization:LocalisedText CorePlugins.HotKey.Reset}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontSize="14"
                Width="83"
                Click="ResetButton_Click"
                Margin="0,9,0,0"
                Grid.Row="1" />
        <CheckBox x:Name="SendByKeybdEventCheckBox"
                  Content="{localization:LocalisedText CorePlugins.HotKey.SendByKeybdEvent}"
                  Grid.Row="2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
